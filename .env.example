# Токен телеграм бота від @BotFather
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# ID супергрупи Telegram (зазвичай починається з -100)
TELEGRAM_CHAT_ID=-1001234567890

# Резервний Playwright використовується лише тоді, коли ДТЕК блокує HTTP.
# false — повністю вимкнути резервний браузер.
DTEK_BROWSER_FALLBACK=true

# Список адрес та їх thread_id (теми/гілки у супергрупі) у форматі JSON
TARGETS='[
  {
    "id": "address_1",
    "name": "Квартира",
    "city": "м. Київ",
    "street": "вул. Хрещатик",
    "house": "1",
    "thread_id": 2
  },
  {
    "id": "address_2",
    "name": "Дача",
    "city": "м. Обухів",
    "street": "вул. Миру",
    "house": "15",
    "thread_id": 5
  }
]'
